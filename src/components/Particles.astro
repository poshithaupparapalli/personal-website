---
// ambient dust behind every page. drifts on its own, lights up near the cursor.
// the homepage draws the brain scan on top of this.
---
<canvas id="dust" aria-hidden="true"></canvas>

<style>
  #dust {
    position: fixed; inset: 0;
    width: 100%; height: 100%;
    z-index: 0; pointer-events: none;
  }
</style>

<script>
  var COUNT  = 260;  // keep this small — it runs on every page
  var CURSOR = 170;  // glow radius, px

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var canvas = document.getElementById('dust') as HTMLCanvasElement;
  var ctx = canvas.getContext('2d')!;
  var W = 0, H = 0, dust: any[] = [], cursor: { x: number; y: number } | null = null;

  var PAL_L = ['242,113,28', '235,62,98', '168,66,235', '92,98,240', '38,118,235'];
  var PAL_D = ['255,158,70', '255,105,125', '216,108,255', '122,132,255', '86,156,255'];
  var PAL = PAL_D;

  // same baked-sprite trick as the brain — one drawImage per particle
  var SPRITE = 32, sprites: HTMLCanvasElement[] = [];
  function bake() {
    sprites = PAL.map(function (rgb) {
      var s = document.createElement('canvas');
      s.width = s.height = SPRITE;
      var c = s.getContext('2d')!;
      var g = c.createRadialGradient(SPRITE / 2, SPRITE / 2, 0, SPRITE / 2, SPRITE / 2, SPRITE / 2);
      g.addColorStop(0, 'rgba(' + rgb + ',1)');
      g.addColorStop(0.35, 'rgba(' + rgb + ',0.85)');
      g.addColorStop(1, 'rgba(' + rgb + ',0)');
      c.fillStyle = g;
      c.fillRect(0, 0, SPRITE, SPRITE);
      return s;
    });
  }

  function palette() {
    PAL = document.documentElement.getAttribute('data-theme') === 'light' ? PAL_L : PAL_D;
    bake();
  }
  new MutationObserver(palette).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme'],
  });

  function gen() {
    dust = [];
    var n = Math.round(COUNT * Math.min(1.4, (W * H) / (1280 * 800)));
    for (var i = 0; i < n; i++) {
      dust.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 0.5 + Math.random() * 1.4,
        c: (Math.random() * 5) | 0,
        a: 0.12 + Math.random() * 0.35,
        // slow drift, so the page feels alive but never busy
        vx: (Math.random() - 0.5) * 0.08,
        vy: -0.02 - Math.random() * 0.09,
        tw: Math.random() * 6.28,
        sp: 0.3 + Math.random() * 0.8,
      });
    }
  }

  function init() {
    W = window.innerWidth; H = window.innerHeight;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    gen();
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, W, H);
    var dark = document.documentElement.getAttribute('data-theme') !== 'light';
    ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';
    var T = t * 0.001;
    var CR2 = CURSOR * CURSOR;
    var spread = dark ? 2.8 : 2.4;

    for (var i = 0; i < dust.length; i++) {
      var d = dust[i];
      if (!reduce) {
        d.x += d.vx; d.y += d.vy;
        // wrap around so the field never empties out
        if (d.y < -10) { d.y = H + 10; d.x = Math.random() * W; }
        if (d.x < -10) d.x = W + 10;
        if (d.x > W + 10) d.x = -10;
      }
      var a = d.a * (reduce ? 0.9 : 0.6 + 0.4 * Math.sin(T * d.sp + d.tw));
      var r = d.r;
      if (dark) a *= 0.9;
      if (cursor) {
        var ex = d.x - cursor.x, ey = d.y - cursor.y, dd = ex * ex + ey * ey;
        if (dd < CR2) {
          var near = 1 - Math.sqrt(dd) / CURSOR;
          a += near * 0.7;
          r *= 1 + near * 0.9;
        }
      }
      if (a <= 0.02) continue;
      if (a > 1) a = 1;
      var s = r * spread;
      ctx.globalAlpha = a;
      ctx.drawImage(sprites[d.c], d.x - s, d.y - s, s * 2, s * 2);
    }
    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = 'source-over';
  }

  var raf: number | null = null;
  function loop(t: number) { draw(t); raf = requestAnimationFrame(loop); }
  function start() {
    init();
    draw(0);
    if (raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(loop);
  }

  window.addEventListener('mousemove', function (e) { cursor = { x: e.clientX, y: e.clientY }; });
  window.addEventListener('mouseout', function () { cursor = null; });
  window.addEventListener('touchmove', function (e) {
    var tc = e.touches[0]; cursor = { x: tc.clientX, y: tc.clientY };
  }, { passive: true });
  window.addEventListener('touchend', function () { cursor = null; });

  var rt: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(start, 150); });

  palette();
  start();
</script>
