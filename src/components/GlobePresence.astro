---
// a dotted globe that lights up wherever someone is reading right now.
// live roster comes from supabase realtime "presence" (no db writes);
// each visitor's city/lat-lng comes from a client-side geo-ip lookup.
// degrades gracefully: with no supabase creds it still spins and shows
// just the current viewer's own location.
---
<div class="globe-wrap">
  <canvas id="globe" aria-label="a globe showing where people are reading from right now"></canvas>
</div>

<style>
  .globe-wrap {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    aspect-ratio: 1;
  }
  #globe {
    width: 100%;
    height: 100%;
    display: block;
    /* cobe wants a square drawing buffer; we set it in js */
    contain: layout paint size;
    cursor: grab;
  }
</style>

<script>
  import createGlobe from 'cobe';
  import { createClient } from '@supabase/supabase-js';

  const URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;

  const canvas = document.getElementById('globe') as HTMLCanvasElement;
  if (canvas) {
    // markers currently on the globe: [{ location: [lat, lng], size }]
    let markers: { location: [number, number]; size: number }[] = [];
    let phi = 0;
    let width = 0;

    const onResize = () => {
      width = canvas.offsetWidth;
    };
    window.addEventListener('resize', onResize);
    onResize();

    const dark = () => document.documentElement.getAttribute('data-theme') !== 'light';

    const globe = createGlobe(canvas, {
      devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
      width: width * 2,
      height: width * 2,
      phi: 0,
      theta: 0.28,
      dark: dark() ? 1 : 0,
      diffuse: 1.2,
      mapSamples: 16000,
      mapBrightness: dark() ? 5 : 8,
      baseColor: dark() ? [0.32, 0.32, 0.35] : [0.72, 0.72, 0.74],
      markerColor: [0.95, 0.45, 0.18], // warm, to match the brain
      glowColor: dark() ? [0.12, 0.12, 0.14] : [0.9, 0.9, 0.92],
      markers: [],
      onRender: (state) => {
        state.phi = phi;
        phi += 0.004;
        state.markers = markers;
        state.width = width * 2;
        state.height = width * 2;
      },
    });

    // ---- geo: the current viewer's own location ----
    async function myLocation() {
      try {
        const r = await fetch('https://ipwho.is/', { signal: AbortSignal.timeout(6000) });
        const d = await r.json();
        if (d && d.success && typeof d.latitude === 'number') {
          return { lat: d.latitude, lng: d.longitude, city: d.city || d.country };
        }
      } catch {}
      return null;
    }

    // ---- presence: everyone reading right now ----
    async function start() {
      const me = await myLocation();
      // show my own dot immediately, even without supabase
      if (me) markers = [{ location: [me.lat, me.lng], size: 0.06 }];

      if (!URL || !KEY) return; // no backend yet — just the local dot

      const supabase = createClient(URL, KEY);
      const id = Math.random().toString(36).slice(2);
      const channel = supabase.channel('live-visitors', {
        config: { presence: { key: id } },
      });

      const sync = () => {
        const state = channel.presenceState() as Record<string, any[]>;
        const seen = Object.values(state)
          .flat()
          .filter((v) => typeof v?.lat === 'number')
          .map((v) => ({ location: [v.lat, v.lng] as [number, number], size: 0.06 }));
        markers = seen.length ? seen : me ? [{ location: [me.lat, me.lng], size: 0.06 }] : [];
      };

      channel
        .on('presence', { event: 'sync' }, sync)
        .subscribe(async (status) => {
          if (status === 'SUBSCRIBED' && me) {
            await channel.track({ lat: me.lat, lng: me.lng, city: me.city });
          }
        });

      window.addEventListener('beforeunload', () => {
        channel.untrack();
        supabase.removeChannel(channel);
      });
    }

    start();

    // keep the globe's day/night in step with the theme toggle
    new MutationObserver(() => {
      // cobe reads these in onRender via the state closure is not enough for
      // colors, so recreate on theme change is overkill; leave palette as-is.
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
