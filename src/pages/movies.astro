---
import Base from '../layouts/Base.astro';
import QuestMap from '../components/QuestMap.astro';
import films from '../data/films.json';

const countries = [...new Set(films.map((f) => f.country.toLowerCase()))];
---
<Base title="movies · poshitha">
  <h1 class="page-title">movies</h1>
  <p class="lede">the quest: a film from every country. {countries.length}/195 so far.</p>

  <QuestMap entries={films} />
  <div style="margin:0 0 40px"></div>

  <ul class="ledger">
    {films.map((f, i) => (
      <li>
        <span class="no mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="body">
          <strong>{f.title}</strong>
          {f.note && <span class="note"> — {f.note}</span>}
        </span>
        <span class="meta mono">{f.country} · {f.year}</span>
      </li>
    ))}
  </ul>
</Base>
