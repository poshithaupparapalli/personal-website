---
import Base from '../layouts/Base.astro';
import quest from '../data/quest.json';

const films = quest.films;
const books = quest.books;
const countries = [...new Set(films.map((f) => f.country))];
const TOTAL = 195;
---
<Base title="movies & books · poshitha">
  <div class="page">
    <h1>movies & books</h1>
    <p class="sub">the quest: a movie from every country in the world</p>

    <p class="count">{countries.length} / {TOTAL} countries</p>

    <ul class="log">
      {films.map((f) => (
        <li>
          <span class="title">{f.title}</span>
          <span class="muted"> — {f.country}, {f.year}</span>
        </li>
      ))}
    </ul>

    <p class="muted">the world map goes here — countries light up as the list grows.
    books are joining too ({books.length} so far).</p>
  </div>

  <style>
    .count{font-size:1.3rem;margin:0 0 20px;}
    .log{list-style:none;padding:0;margin:0 0 34px;}
    .log li{padding:8px 0;border-bottom:1px solid var(--line);}
    .title{font-weight:500;}
  </style>
</Base>
