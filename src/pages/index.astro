---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

const hasPhoto = fs.existsSync('public/cover.jpg');

// everything dropped in public/photos shows up in the gallery below, A→Z.
// prefix filenames 01_, 02_… to control the order.
const photoDir = 'public/photos';
const photos = fs.existsSync(photoDir)
  ? fs
      .readdirSync(photoDir)
      .filter((f) => /\.(jpe?g|png|webp|gif|avif)$/i.test(f))
      .sort()
  : [];

// hover captions for the gallery — key is the exact filename in public/photos.
// fill these in whenever; any photo without one just has no caption on hover.
const captions: Record<string, string> = {
  // '01_mongolia.jpg': 'wild horses outside ulaanbaatar',
};
---
<Base title="poshitha upparapalli">
  <h1>poshitha upparapalli</h1>

  <div class="intro">
    <ul class="links">
      <li><a href="https://github.com/poshithaupparapalli" target="_blank" rel="noopener">github</a></li>
      <li><a href="https://www.linkedin.com/in/poshithar/" target="_blank" rel="noopener">linkedin</a></li>
      <li><a href="mailto:pou228@lehigh.edu">mail</a></li>
    </ul>
  </div>

  <div class="copy">
    <div class="lead">
      {hasPhoto && <img class="me" src="/cover.jpg" alt="poshitha" />}
      <p class="statement">
        hi, i'm poshitha. i'm 19, studying computer science & engineering + finance with a
        math minor at <a href="https://www2.lehigh.edu/" target="_blank" rel="noopener">lehigh</a>.
      </p>
    </div>
    <p>
      right now, i'm a junior technical analyst at <a href="https://sra.samsung.com/" target="_blank" rel="noopener">samsung research america</a>
      and support due diligence and investing at <a href="https://kidron-capital.com/wp-content/uploads/New_Kidron/kidron_homepage-2.html" target="_blank" rel="noopener">kidron capital</a>.
      previously, i was a software engineer at <a href="https://elevatevbsolutions.com/" target="_blank" rel="noopener">elevate</a>
      and built credit risk models at <a href="https://credit.ford.com/" target="_blank" rel="noopener">ford credit</a>.
    </p>
    <p>
      my interests span deep learning, computer vision, machine perception,
      reasoning, reinforcement learning, and robotics. i'm also exploring ai
      safety research and learning
      <a href="https://lean-lang.org/" target="_blank" rel="noopener">lean</a>
      and formal verification.
    </p>
    <p>
      i also spend a lot of time researching and writing about which companies
      are leading in ai in a safe and ethical way, and share those thoughts in
      the <a href="https://lehighscholarsoffinance.substack.com/" target="_blank" rel="noopener">sof research rundown</a>.
    </p>
    <p>
      outside of work, i love cooking, trying new places to eat (find me on
      <a href="https://beliapp.co/app/poshi" target="_blank" rel="noopener">beli</a>),
      running, taking pictures + videos, hiking, and going on long walks toward
      unnecessarily expensive coffee (my <a href="/coffee">favorite cafes in sf</a>).
      i grew up doing competitive abacus and trained in bharatanatyam, a form of
      indian classical dance.
    </p>
    <p>
      feel free to reach out at pou228 [at] lehigh [dot] edu!
    </p>
    <p class="jump">
      <a href="/about">↗ more about me</a>
      <a href="/projects">↗ projects</a>
      <a href="/work">↗ work</a>
    </p>
  </div>

  {photos.length > 0 && (
    <>
      <h2 class="photos-label">photos</h2>
      <section class="gallery" aria-label="photos i've taken">
        {photos.map((f) => (
          <figure class="shot">
            <img src={`/photos/${f}`} alt={captions[f] ?? ''} loading="lazy" />
            {captions[f] && <figcaption>{captions[f]}</figcaption>}
          </figure>
        ))}
      </section>
    </>
  )}

  <style>
    h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 28px; }
    .intro { display: flex; align-items: center; gap: 24px; margin: 0 0 32px; }
    /* small round photo beside the first paragraph; text never wraps under it */
    .lead { display: flex; align-items: center; gap: 20px; margin: 0 0 18px; }
    .lead .statement { margin: 0; }
    .me { width: 78px; height: 78px; border-radius: 50%; object-fit: cover; object-position: center 28%; flex-shrink: 0; }
    @media (max-width: 520px) { .me { width: 64px; height: 64px; } .lead { gap: 14px; } }
    .links { list-style: none; margin: 0; padding: 0; display: flex; gap: 18px; }
    .links a { color: var(--muted); text-decoration: none; }
    .links a:hover { color: var(--ink); }
    p { margin: 0 0 18px; max-width: 56ch; }
    .copy p { font-size: 0.85rem; }
    .statement { font-size: 1rem; line-height: 1.55; }

    .jump { display: flex; gap: 20px; margin-top: 36px; }
    .jump a { color: var(--muted); text-decoration: none; }
    .jump a:hover { color: var(--ink); }

    /* photos — a wide grid below the bio that breaks out of the text column */
    .photos-label {
      clear: both;
      margin: 96px 0 18px; font-size: 0.85rem; font-weight: 500;
      color: var(--muted); letter-spacing: 0.02em;
    }
    .gallery {
      /* break out of .wrap to span the full viewport, like the reference */
      width: 100vw; position: relative; left: 50%; right: 50%;
      margin-left: -50vw; margin-right: -50vw;
      padding: 0 16px 24px;
      display: grid; gap: 10px;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }
    .shot {
      position: relative; margin: 0; aspect-ratio: 1 / 1;
      overflow: hidden; background: var(--line);
      opacity: 0; transform: translateY(16px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .shot.in { opacity: 1; transform: none; }
    .shot img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 0.5s ease;
    }
    .shot:hover img { transform: scale(1.03); }
    /* caption slides up over the photo on hover (empty ones render nothing) */
    .shot figcaption {
      position: absolute; left: 0; right: 0; bottom: 0;
      padding: 14px 12px 10px; font-size: 0.8rem; line-height: 1.35; color: #fff;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
      opacity: 0; transition: opacity 0.3s ease;
    }
    .shot:hover figcaption { opacity: 1; }

    @media (prefers-reduced-motion: reduce) {
      .shot { opacity: 1; transform: none; transition: none; }
    }
  </style>

  <script>
    // fade/rise each photo in as it scrolls into view
    const shots = document.querySelectorAll('.shot');
    if (shots.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      shots.forEach((el) => io.observe(el));
    }
  </script>
</Base>
