---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

const hasPhoto = fs.existsSync('public/cover.jpg');
---
<Base title="poshitha upparapalli">
  <h1>poshitha upparapalli</h1>

  <div class="intro">
    {hasPhoto && <img class="me" src="/cover.jpg" alt="poshitha" />}
    <ul class="links">
      <li><a href="https://github.com/" target="_blank" rel="noopener">github</a></li>
      <li><a href="https://www.linkedin.com/in/poshithar/" target="_blank" rel="noopener">linkedin</a></li>
      <li><a href="mailto:pou228@lehigh.edu">mail</a></li>
    </ul>
  </div>

  <p class="statement">
    i study computer science and finance at lehigh.
    right now i'm in san francisco, building AI for small-business owners.
  </p>

  <!-- a real brain, redrawn live in ascii — MRI tissue underneath,
       MR angiography vessels on top. scans: "MRI of Human Brain"
       (CC BY-SA 4.0) + "Mra-mip" (CC BY-SA 3.0), wikimedia commons -->
  <canvas id="brain" aria-hidden="true"></canvas>
  <div class="fold"></div>

  <p>
    i'm interested in human-brain interfaces, reinforcement learning,
    computer vision, and reasoning — machines that learn, and the brains
    they're modeled after.
  </p>
  <p>
    <a href="/about">more about me</a>
  </p>

  <p class="jump">
    <a href="/work">↗ work</a>
    <a href="/projects">↗ projects</a>
    <a href="/writings">↗ writings</a>
  </p>

  <style>
    h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 28px; }
    .intro { display: flex; align-items: center; gap: 24px; margin: 0 0 32px; }
    .me { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }
    .links { list-style: none; margin: 0; padding: 0; display: flex; gap: 18px; }
    .links a { color: var(--muted); text-decoration: none; }
    .links a:hover { color: var(--ink); }
    p { margin: 0 0 18px; max-width: 56ch; }
    .statement { font-size: 1.2rem; line-height: 1.55; }

    /* the brain lives behind the whole first screen; text floats over it */
    #brain {
      position: absolute; top: 0; left: 0;
      width: 100vw; height: 100vh; min-height: 500px;
      z-index: -1;
    }
    /* pushes everything after it below the fold */
    .fold { height: calc(100vh - 330px); min-height: 120px; }

    .jump { display: flex; gap: 20px; margin-top: 36px; }
    .jump a { color: var(--muted); text-decoration: none; }
    .jump a:hover { color: var(--ink); }
  </style>

  <script>
    /* ---------------- TUNABLE DIALS ---------------- */
    var STEP    = 3.4;  // sampling grid, px — smaller = denser
    var SPECKS  = 900;  // ambient dust around the scan
    var CURSOR  = 180;  // cursor glow radius, px
    var TWINKLE = 1;    // shimmer speed
    var GLOW    = 1;    // bloom on the bright particles at night
    /* ----------------------------------------------- */

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var canvas = document.getElementById('brain') as HTMLCanvasElement,
      ctx = canvas.getContext('2d')!;
    var W = 0, H = 0, buckets: any[][] = [], cursor: { x: number; y: number } | null = null;

    // false-color like an ultrasound: bright tissue runs warm, dim runs cool
    var PAL_L = ['242,113,28', '235,62,98', '168,66,235', '92,98,240', '38,118,235'];
    var PAL_D = ['255,158,70', '255,105,125', '216,108,255', '122,132,255', '86,156,255'];
    var PAL = PAL_L;
    function palette() {
      PAL = document.documentElement.getAttribute('data-theme') === 'dark' ? PAL_D : PAL_L;
    }
    new MutationObserver(function () { palette(); draw(performance.now()); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // particle radii, near/mid/far — the scan is drawn as dots, like the real thing
    var SIZES = [0.55, 0.95, 1.6];

    function addDot(bx: number, x: number, y: number, c: number, a: number, z: number) {
      // keep the words readable — dust fades in gradually below the text,
      // no hard edge
      if (y < H * 0.56 && x > W * 0.24 && x < W * 0.76) {
        var t = Math.max(0, y / (H * 0.56));
        var keep = 0.08 + 0.92 * t * t;
        if (Math.random() > keep) return;
        a *= 0.3 + 0.7 * t;
      }
      buckets[bx].push({
        x: x, y: y, c: c, a: a, z: z,
        r: SIZES[bx] * (0.75 + Math.random() * 0.6),
        tw: Math.random() * 6.28, sp: 0.4 + Math.random() * 1.1
      });
    }

    // two real scans — MRI tissue below, angiography vessels on top
    var tissue = new Image(), vessels = new Image();
    var loaded = 0;
    tissue.onload = vessels.onload = function () { if (++loaded === 2) start(); };
    tissue.src = '/brain-scan.jpg';
    vessels.src = '/brain-vessels.jpg';

    function sample(im: HTMLImageElement, opts: any) {
      var mobile = W < 600;
      var step = STEP * (mobile ? 1.7 : 1) * (opts.step || 1);

      // crop hard into the skull so only brain renders
      var sw = im.width * opts.cropW, sh = im.height * opts.cropH;
      var sx = (im.width - sw) / 2, sy = (im.height - sh) / 2 + im.height * 0.01;

      // fit into the lower part of the screen, big
      var bh = H * (mobile ? 0.52 : 0.8);
      var bw = bh * (sw / sh);
      if (bw > W * 0.96) { bw = W * 0.96; bh = bw * (sh / sw); }
      var bx0 = (W - bw) / 2, by0 = H * 0.98 - bh;

      var gw = Math.max(2, Math.round(bw / step)), gh = Math.max(2, Math.round(bh / step));
      var off = document.createElement('canvas');
      off.width = gw; off.height = gh;
      var octx = off.getContext('2d', { willReadFrequently: true })!;
      octx.drawImage(im, sx, sy, sw, sh, 0, 0, gw, gh);
      var data = octx.getImageData(0, 0, gw, gh).data;

      for (var gy = 0; gy < gh; gy++) {
        for (var gx = 0; gx < gw; gx++) {
          // elliptical mask — kills the skull ring left by the square crop
          var mx = (gx - gw / 2) / (gw / 2), my = (gy - gh / 2) / (gh / 2);
          if (mx * mx + my * my > 1) continue;
          var i = (gy * gw + gx) * 4;
          var v = (data[i] * 0.35 + data[i + 1] * 0.5 + data[i + 2] * 0.15) / 255;
          v = Math.min(1, Math.pow(v, opts.gamma) * opts.gain);
          if (v < opts.floor) continue;
          if (Math.random() > opts.keep + v * (1 - opts.keep)) continue;

          var x = bx0 + (gx + 0.5) / gw * bw + (Math.random() - 0.5) * step * 1.4;
          var y = by0 + (gy + 0.5) / gh * bh + (Math.random() - 0.5) * step * 1.4;
          opts.emit(x, y, v);
        }
      }
      return { bx0: bx0, by0: by0, bw: bw, bh: bh };
    }

    function gen() {
      buckets = [[], [], []];
      if (loaded < 2) return;
      var mobile = W < 600;

      // layer 1: tissue — faint, cool, far away. just enough to suggest a brain
      var rect = sample(tissue, {
        cropW: 0.54, cropH: 0.6, step: 1.5, gamma: 0.9, gain: 1, floor: 0.1, keep: 0.06,
        emit: function (x: number, y: number, v: number) {
          var c = v > 0.55 ? 3 : 4; // blues only — it sits behind everything
          addDot(0, x, y, c, 0.07 + v * 0.22, 0.3 + v * 0.2);
        },
      });

      // layer 2: vasculature — bright, warm, close. the aleph streaks.
      // sampled fine so thin arteries stay continuous instead of dotty
      sample(vessels, {
        cropW: 0.82, cropH: 0.84, step: 0.55, gamma: 1.5, gain: 1.5, floor: 0.2, keep: 0.72,
        emit: function (x: number, y: number, v: number) {
          var c = v > 0.62 ? 0 : v > 0.45 ? 1 : v > 0.3 ? 2 : 3; // orange → pink → purple
          if (Math.random() < 0.14) c = (c + 1) % 5;
          addDot(v > 0.6 ? 2 : v > 0.34 ? 1 : 0, x, y, c, 0.35 + v * 0.65, 0.75 + v * 0.5);
        },
      });

      // ambient dust drifting off the scan
      var cx = W * 0.5, cy = rect.by0 + rect.bh * 0.5, rx = rect.bw * 0.62, ry = rect.bh * 0.6;
      for (var s = 0; s < SPECKS * (mobile ? 0.4 : 1); s++) {
        var t = Math.random() * 6.28, r = Math.sqrt(Math.random());
        addDot(0, cx + Math.cos(t) * r * rx * 1.2, cy + Math.sin(t) * r * ry * 1.2,
          (Math.random() * 5) | 0, 0.06 + Math.random() * 0.18, 0.2 + Math.random() * 0.9);
      }
    }

    function init() {
      var rect = canvas.getBoundingClientRect(); W = rect.width; H = rect.height;
      if (!W || !H) return;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      gen();
    }

    // parallax eases toward the cursor so the depth feels weighty, not jittery
    var paraX = 0, paraY = 0;

    function draw(t: number) {
      ctx.clearRect(0, 0, W, H);
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      var T = t * 0.001 * TWINKLE;
      var CR2 = CURSOR * CURSOR;
      var dark = document.documentElement.getAttribute('data-theme') === 'dark';

      var tx = cursor ? (cursor.x - W / 2) * 0.035 : Math.sin(T * 0.13) * 9;
      var ty = cursor ? (cursor.y - H / 2) * 0.035 : Math.cos(T * 0.1) * 7;
      paraX += (tx - paraX) * 0.04; paraY += (ty - paraY) * 0.04;

      // at night the particles add together where they overlap, so dense
      // vessels burn bright the way they do in the real scan
      ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';

      for (var b = 0; b < 3; b++) {
        // only the big foreground particles get bloom — it's expensive
        ctx.shadowBlur = dark && b >= 1 ? (b === 2 ? 8 : 4) * GLOW : 0;
        var list = buckets[b];
        for (var i = 0; i < list.length; i++) {
          var d = list[i];
          var x = d.x + paraX * d.z, y = d.y + paraY * d.z;
          var a = d.a * (reduce ? 0.85 : 0.62 + 0.38 * Math.sin(T * d.sp + d.tw));
          // additive blending on black eats brightness — push it back up
          var r = d.r;
          if (dark) { a *= 1.75; r *= 1.15; }
          if (cursor) {
            var ex = x - cursor.x, ey = y - cursor.y, dd = ex * ex + ey * ey;
            if (dd < CR2) {
              var near = 1 - Math.sqrt(dd) / CURSOR;
              a += near * 0.6;
              r *= 1 + near * 0.5; // particles swell as you pass over them
            }
          }
          if (a <= 0.02) continue;
          if (a > 1) a = 1;
          var col = 'rgba(' + PAL[d.c] + ',' + a.toFixed(3) + ')';
          if (ctx.shadowBlur) ctx.shadowColor = col;
          ctx.fillStyle = col;
          ctx.beginPath();
          ctx.arc(x, y, r, 0, 6.2832);
          ctx.fill();
        }
      }
      ctx.shadowBlur = 0;
      ctx.globalCompositeOperation = 'source-over';
    }

    var raf: number | null = null;
    function loop(t: number) { draw(t); raf = requestAnimationFrame(loop); }
    function start() {
      init();
      draw(0); // paint immediately — don't wait for the animation loop
      if (!reduce) { if (raf) cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); }
    }

    // the canvas sits behind the page, so listen on the window
    window.addEventListener('mousemove', function (e) {
      var r = canvas.getBoundingClientRect();
      cursor = { x: e.clientX - r.left, y: e.clientY - r.top };
      if (reduce) draw(0);
    });
    window.addEventListener('mouseout', function () { cursor = null; if (reduce) draw(0); });
    window.addEventListener('touchmove', function (e) {
      var r = canvas.getBoundingClientRect(); var tc = e.touches[0];
      cursor = { x: tc.clientX - r.left, y: tc.clientY - r.top };
    }, { passive: true });
    window.addEventListener('touchend', function () { cursor = null; });

    var rt: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(start, 150); });

    palette();
    start();
  </script>
</Base>
