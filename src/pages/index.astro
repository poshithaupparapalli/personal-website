---
import Base from '../layouts/Base.astro';
---
<Base title="Poshitha Upparapalli">
  <div class="hero">
    <h1>Poshitha Upparapalli</h1>
    <div class="select" aria-hidden="true">
      <span class="h tl"></span><span class="h tm"></span><span class="h tr"></span>
      <span class="h ml"></span><span class="h mr"></span>
      <span class="h bl"></span><span class="h bm"></span><span class="h br"></span>
    </div>
  </div>

  <div class="intro">
    <ul class="links">
      <li>
        <a href="https://github.com/poshithaupparapalli" target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.22.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/poshithar/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM0 8h5v16H0V8zm7.5 0H12v2.2h.07c.63-1.2 2.17-2.47 4.47-2.47C21.4 7.73 24 10.1 24 14.6V24h-5v-8.4c0-2-.04-4.58-2.8-4.58-2.8 0-3.23 2.18-3.23 4.43V24h-5V8z"/></svg>
        </a>
      </li>
      <li>
        <a href="mailto:pou228@lehigh.edu" aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
        </a>
      </li>
    </ul>
  </div>

  <div class="copy">
    <p class="statement">
      Hi, I'm Poshitha! I'm 19, studying Computer Science & Engineering + Finance with a
      math minor at <a href="https://www2.lehigh.edu/" target="_blank" rel="noopener">Lehigh</a>.
    </p>
    <p>
      Right now, I'm a Junior Technical Analyst at <a href="https://sra.samsung.com/" target="_blank" rel="noopener">Samsung Research America</a>
      and support due diligence and investing at <a href="https://kidron-capital.com/wp-content/uploads/New_Kidron/kidron_homepage-2.html" target="_blank" rel="noopener">Kidron Capital</a>.
    </p>
    <p>
      My interests span deep learning, computer vision, machine perception,
      reasoning, reinforcement learning, and robotics. I'm also exploring AI
      safety research and learning
      <a href="https://lean-lang.org/" target="_blank" rel="noopener">Lean</a>
      and formal verification.
    </p>
    <p>
      Outside of work, I love cooking, trying new places to eat (find me on
      <a href="https://beliapp.co/app/poshi" target="_blank" rel="noopener">Beli</a>),
      running, taking pictures + videos, hiking, and going on long walks toward
      unnecessarily expensive coffee (my <a href="/coffee">favorite cafes in SF</a>).
    </p>
    <p>
      I grew up in Tirupati, India. <a href="/about">More about me</a>.
    </p>
    <p>
      Feel free to reach out at pou228 [at] lehigh [dot] edu!
    </p>
  </div>

  <style>
    /* name sits inside a "selection" that snaps its handles in on load, then releases */
    .hero { position: relative; display: inline-block; margin: 0 0 20px; }
    h1 { font-size: 1.5rem; font-weight: 600; margin: 0; }

    .select {
      position: absolute; inset: -9px -12px; border: 1px solid #3b5bd6;
      opacity: 0; pointer-events: none;
      animation: selbox 1.3s ease forwards;
    }
    .select .h {
      position: absolute; width: 7px; height: 7px;
      background: #fff; border: 1px solid #3b5bd6;
      transform: scale(0);
      animation: handle 1.3s ease forwards;
    }
    .tl { top: -4px; left: -4px; }
    .tm { top: -4px; left: calc(50% - 3.5px); }
    .tr { top: -4px; right: -4px; }
    .ml { top: calc(50% - 3.5px); left: -4px; }
    .mr { top: calc(50% - 3.5px); right: -4px; }
    .bl { bottom: -4px; left: -4px; }
    .bm { bottom: -4px; left: calc(50% - 3.5px); }
    .br { bottom: -4px; right: -4px; }
    /* tiny stagger so the handles snap in one after another */
    .tl { animation-delay: 0s; }
    .tr { animation-delay: 0.04s; }
    .bl { animation-delay: 0.08s; }
    .br { animation-delay: 0.12s; }
    .tm, .bm, .ml, .mr { animation-delay: 0.16s; }

    @keyframes selbox {
      0% { opacity: 0; } 18% { opacity: 1; } 64% { opacity: 1; } 100% { opacity: 0; }
    }
    @keyframes handle {
      0% { transform: scale(0); opacity: 1; }
      22% { transform: scale(1); }
      64% { transform: scale(1); opacity: 1; }
      100% { transform: scale(1); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .select { display: none; }
    }
    .intro { display: flex; align-items: center; gap: 24px; margin: 0 0 32px; }
    .links { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 16px; }
    .links a { color: var(--muted); display: inline-flex; }
    .links a:hover { color: var(--ink); }
    .links svg { width: 20px; height: 20px; display: block; }

    p { margin: 0 0 16px; max-width: 62ch; }
    .copy p { font-size: 0.9rem; }
    .statement { font-size: 1rem; }
  </style>
</Base>
