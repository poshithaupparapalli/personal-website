---
import Base from '../layouts/Base.astro';
---
<Base title="poshitha">
  <canvas id="web" aria-hidden="true"></canvas>

  <div class="main">
    <div class="intro">
      <p class="lead">hi, i'm poshitha.</p>
      <p>i study computer science and finance with a math minor at lehigh. i'm especially interested in human-brain interfaces, reinforcement learning, math, computer vision, and reasoning. right now i'm working with a very cool founder to build out an AI application for small-business owners. i also spend time thinking and reading about which companies are leading AI innovation in a safe and ethical way.</p>
      <div class="find">
        <a href="mailto:pou228@lehigh.edu">email</a>
        <a href="#">github</a>
        <a href="https://www.linkedin.com/in/poshithar/">linkedin</a>
      </div>
    </div>
  </div>

  <style>
    #web{position:fixed;inset:0;width:100%;height:100%;z-index:0;}
    .main{
      position:relative;z-index:1;min-height:100vh;
      display:flex;align-items:center;justify-content:flex-end;
      padding:0 8vw;pointer-events:none;
    }
    .main a{pointer-events:auto;}
    .intro{max-width:430px;}
    .intro .lead{font-size:1.15rem;font-weight:500;margin:0 0 14px;}
    .intro p{margin:0 0 16px;font-size:.98rem;}
    .find{display:flex;gap:18px;margin-top:22px;flex-wrap:wrap;}
    .find a{
      font-size:.9rem;color:var(--ink-soft);text-decoration:none;
      border-bottom:1px solid var(--line);padding-bottom:2px;transition:.2s;
    }
    .find a:hover{color:var(--link);border-color:var(--link);}
    @media (max-width:780px){
      .main{align-items:flex-end;justify-content:flex-start;padding:130px 8vw 60px;}
      .intro p{font-size:.92rem;}
    }
  </style>

  <script>
    /* ---------------- TUNABLE DIALS ---------------- */
    var SPEED  = 3;    // how fast the brain "breathes"
    var AMP    = 4;    // how far each node drifts from its spot
    var INSIDE = 210;  // nodes inside the brain (mobile gets fewer)
    var R      = 74;   // link reach between nodes, design units
    var CB     = 180;  // cursor burst reach, screen px
    var CR     = 170;  // node light-up distance from cursor, screen px
    var PULSES = 5;    // max signals firing at once
    /* ----------------------------------------------- */

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // brain side-profile, facing right (design space 1000x700)
    var P = [
      [815,295],[840,340],[830,395],[790,430],[730,455],[660,470],[600,470],
      [560,500],[500,520],[430,515],[380,490],[345,470],
      [330,520],[345,580],[310,592],[288,530],[288,482],
      [230,470],[185,430],[160,370],[155,300],[175,235],[220,180],
      [290,140],[380,115],[480,105],[580,112],[670,135],[750,175],[800,230]
    ];
    var DW = 1000, DH = 700;
    function inPoly(x, y) {
      var c = false;
      for (var i = 0, j = P.length - 1; i < P.length; j = i++) {
        var xi = P[i][0], yi = P[i][1], xj = P[j][0], yj = P[j][1];
        if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) c = !c;
      }
      return c;
    }

    var canvas = document.getElementById('web'), ctx = canvas.getContext('2d');
    var W = 0, H = 0, scale = 1, offX = 0, offY = 0;
    var nodes = [], pairs = [], adj = [], pulses = [], cursor = null;
    var NPAL, LINK, PULSE, GLOW, dark = false;

    function palette() {
      dark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (dark) {
        NPAL = ['150,178,228', '172,162,235', '128,188,238', '205,212,245'];
        LINK = '130,158,212'; PULSE = '170,200,255'; GLOW = true;
      } else {
        NPAL = ['21,40,76', '21,40,76', '35,64,214', '60,84,160'];
        LINK = '35,64,214'; PULSE = '35,64,214'; GLOW = false;
      }
    }
    new MutationObserver(function () { palette(); if (reduce) draw(0); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    function addNode(x, y, r) {
      nodes.push({ bx: x, by: y, x: x, y: y, r: r,
        ph: Math.random() * 6.28, sp: 0.5 + Math.random() * 0.7,
        ci: (Math.random() * 4) | 0 });
    }

    function init() {
      var rect = canvas.getBoundingClientRect(); W = rect.width; H = rect.height;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      var mobile = W < 780;
      var boxW = mobile ? W * 1.02 : W * 0.72;
      scale = boxW / DW;
      if (DH * scale > H * 0.95) scale = (H * 0.95) / DH;
      offX = mobile ? (W - DW * scale) / 2 : W * 0.03;
      offY = (H - DH * scale) / 2 - (mobile ? H * 0.06 : 0);

      nodes = []; pulses = [];

      // trace the outline first so the silhouette actually reads as a brain
      var step = mobile ? 24 : 17;
      for (var e = 0; e < P.length; e++) {
        var a = P[e], b = P[(e + 1) % P.length];
        var dx = b[0] - a[0], dy = b[1] - a[1], len = Math.sqrt(dx * dx + dy * dy);
        var n = Math.max(1, Math.round(len / step));
        for (var s = 0; s < n; s++) {
          var t = s / n;
          // nudge inward a touch so the edge stays soft
          addNode(a[0] + dx * t + (500 - (a[0] + dx * t)) * 0.015 + (Math.random() - 0.5) * 7,
                  a[1] + dy * t + (350 - (a[1] + dy * t)) * 0.015 + (Math.random() - 0.5) * 7,
                  1.3 + Math.random() * 0.9);
        }
      }

      // then fill the inside, spaced out so it doesn't clump
      var want = mobile ? Math.round(INSIDE * 0.6) : INSIDE;
      var minD2 = (mobile ? 30 : 26); minD2 *= minD2;
      var placed = 0, tries = 0;
      while (placed < want && tries < want * 90) {
        tries++;
        var x = 150 + Math.random() * 700, y = 100 + Math.random() * 500;
        if (!inPoly(x, y)) continue;
        var ok = true;
        for (var k = 0; k < nodes.length; k++) {
          var ddx = nodes[k].bx - x, ddy = nodes[k].by - y;
          if (ddx * ddx + ddy * ddy < minD2) { ok = false; break; }
        }
        if (!ok) continue;
        addNode(x, y, 1.5 + Math.random() * 1.3);
        placed++;
      }

      // resting links + adjacency (for the traveling signals)
      pairs = []; adj = [];
      for (var i2 = 0; i2 < nodes.length; i2++) adj.push([]);
      var R2 = R * R;
      for (var i = 0; i < nodes.length; i++)
        for (var j = i + 1; j < nodes.length; j++) {
          var lx = nodes[i].bx - nodes[j].bx, ly = nodes[i].by - nodes[j].by;
          if (lx * lx + ly * ly <= R2) { pairs.push([i, j]); adj[i].push(j); adj[j].push(i); }
        }
    }

    function PX(n) { return offX + n.x * scale; }
    function PY(n) { return offY + n.y * scale; }

    var spawnT = 0;
    function step(dt) {
      spawnT += dt;
      if (spawnT > 550 && pulses.length < PULSES && nodes.length) {
        spawnT = 0;
        var from = (Math.random() * nodes.length) | 0;
        if (adj[from].length) {
          var to = adj[from][(Math.random() * adj[from].length) | 0];
          pulses.push({ from: from, to: to, t: 0, hops: 0, sp: 0.9 + Math.random() * 0.8 });
        }
      }
      for (var p = pulses.length - 1; p >= 0; p--) {
        var pu = pulses[p];
        pu.t += dt * 0.0018 * pu.sp;
        if (pu.t >= 1) {
          pu.hops++;
          if (pu.hops >= 4) { pulses.splice(p, 1); continue; }
          var prev = pu.from; pu.from = pu.to; pu.t = 0;
          var opts = [];
          for (var o = 0; o < adj[pu.from].length; o++)
            if (adj[pu.from][o] !== prev) opts.push(adj[pu.from][o]);
          if (!opts.length) opts = adj[pu.from];
          if (!opts.length) { pulses.splice(p, 1); continue; }
          pu.to = opts[(Math.random() * opts.length) | 0];
        }
      }
    }

    function draw(t) {
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        if (reduce) { n.x = n.bx; n.y = n.by; }
        else {
          n.x = n.bx + Math.sin(t * 0.0006 * SPEED * n.sp + n.ph) * AMP;
          n.y = n.by + Math.cos(t * 0.00052 * SPEED * n.sp + n.ph) * AMP;
        }
      }
      // resting links
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(' + LINK + ',' + (dark ? 0.13 : 0.1) + ')';
      ctx.beginPath();
      for (var p = 0; p < pairs.length; p++) {
        var a = nodes[pairs[p][0]], b = nodes[pairs[p][1]];
        ctx.moveTo(PX(a), PY(a)); ctx.lineTo(PX(b), PY(b));
      }
      ctx.stroke();
      // cursor bursts
      if (cursor) {
        var CB2 = CB * CB;
        for (var c = 0; c < nodes.length; c++) {
          var px = PX(nodes[c]), py = PY(nodes[c]);
          var dx = px - cursor.x, dy = py - cursor.y, d2 = dx * dx + dy * dy;
          if (d2 < CB2) {
            var al = (1 - Math.sqrt(d2) / CB) * (dark ? 0.5 : 0.4);
            ctx.strokeStyle = 'rgba(' + LINK + ',' + al.toFixed(3) + ')';
            ctx.beginPath(); ctx.moveTo(cursor.x, cursor.y); ctx.lineTo(px, py); ctx.stroke();
          }
        }
      }
      // traveling signals
      for (var s = 0; s < pulses.length; s++) {
        var pu = pulses[s], na = nodes[pu.from], nb = nodes[pu.to];
        var x1 = PX(na), y1 = PY(na), x2 = PX(nb), y2 = PY(nb);
        var x = x1 + (x2 - x1) * pu.t, y = y1 + (y2 - y1) * pu.t;
        ctx.strokeStyle = 'rgba(' + PULSE + ',0.45)';
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x, y); ctx.stroke();
        ctx.shadowColor = 'rgba(' + PULSE + ',0.9)'; ctx.shadowBlur = 12;
        ctx.fillStyle = 'rgba(' + PULSE + ',0.95)';
        ctx.beginPath(); ctx.arc(x, y, 2.4, 0, Math.PI * 2); ctx.fill();
        ctx.shadowBlur = 0;
      }
      // nodes
      var CR2 = CR * CR;
      for (var k = 0; k < nodes.length; k++) {
        var nd = nodes[k], px2 = PX(nd), py2 = PY(nd), boost = 0;
        if (cursor) {
          var ex = px2 - cursor.x, ey = py2 - cursor.y, dd = ex * ex + ey * ey;
          if (dd < CR2) boost = 1 - Math.sqrt(dd) / CR;
        }
        var col = NPAL[nd.ci];
        var alpha = (dark ? 0.5 : 0.42) + boost * 0.55;
        if (GLOW) { ctx.shadowColor = 'rgba(' + col + ',' + (0.5 + boost * 0.4) + ')'; ctx.shadowBlur = 5 + boost * 8; }
        else if (boost > 0) { ctx.shadowColor = 'rgba(' + col + ',0.5)'; ctx.shadowBlur = boost * 7; }
        ctx.fillStyle = 'rgba(' + col + ',' + alpha.toFixed(3) + ')';
        ctx.beginPath(); ctx.arc(px2, py2, nd.r * (1 + boost * 0.7), 0, Math.PI * 2); ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    var raf = null, last = 0;
    function loop(t) {
      var dt = last ? Math.min(t - last, 50) : 16; last = t;
      step(dt); draw(t);
      raf = requestAnimationFrame(loop);
    }
    function start() {
      init();
      if (reduce) { draw(0); }
      else { if (raf) cancelAnimationFrame(raf); last = 0; raf = requestAnimationFrame(loop); }
    }

    window.addEventListener('mousemove', function (e) { cursor = { x: e.clientX, y: e.clientY }; if (reduce) draw(0); });
    window.addEventListener('mouseout', function () { cursor = null; if (reduce) draw(0); });
    window.addEventListener('touchmove', function (e) { var tc = e.touches[0]; cursor = { x: tc.clientX, y: tc.clientY }; if (reduce) draw(0); }, { passive: true });
    window.addEventListener('touchend', function () { cursor = null; });

    var rt;
    window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(start, 150); });

    palette();
    start();
  </script>
</Base>
