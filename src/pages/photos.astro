---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// full-size photos live in public/photos; small thumbs in public/photos/thumbs.
const dir = 'public/photos';
const files = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => /\.(jpe?g|png|webp)$/i.test(f)).sort()
  : [];

const thumb = (f: string) =>
  fs.existsSync(`${dir}/thumbs/${f}`) ? `/photos/thumbs/${f}` : `/photos/${f}`;
---
<Base title="Photos · Poshitha">
  <h1 class="page-title">Photos</h1>

  {files.length > 0 ? (
    <ul class="grid">
      {files.map((f, i) => (
        <li class="cell">
          <a href={`/photos/${f}`} target="_blank" rel="noopener">
            <div class="frame"><img src={thumb(f)} alt="" loading="lazy" /></div>
          </a>
          <div class="num">({i + 1})</div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted">no photos yet.</p>
  )}

  <style>
    .grid {
      list-style: none; margin: 0; padding: 0 0 40px;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px 18px;
    }
    .cell { margin: 0; }
    .frame {
      aspect-ratio: 1 / 1; overflow: hidden; background: var(--line); border-radius: 2px;
    }
    .frame img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: opacity 0.2s ease;
    }
    .cell a:hover .frame img { opacity: 0.9; }
    .num { text-align: center; margin-top: 10px; color: var(--muted); font-size: 0.8rem; }

    @media (max-width: 640px) {
      .grid { grid-template-columns: repeat(2, 1fr); gap: 24px 12px; }
    }
  </style>
</Base>
