---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// full-size in public/photos, small thumbs in public/photos/thumbs.
const dir = 'public/photos';
const files = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => /\.(jpe?g|png|webp)$/i.test(f)).sort()
  : [];

// seeded shuffle so the mix is varied but stable between builds
const rng = (() => {
  let s = 20260211;
  return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
})();
for (let i = files.length - 1; i > 0; i--) {
  const j = Math.floor(rng() * (i + 1));
  [files[i], files[j]] = [files[j], files[i]];
}

const thumb = (f: string) =>
  fs.existsSync(`${dir}/thumbs/${f}`) ? `/photos/thumbs/${f}` : `/photos/${f}`;
---
<Base title="Photos · Poshitha">
  {files.length > 0 && (
    <div class="gallery-sizes" role="group" aria-label="photo size">
      <button type="button" data-size="s">S</button>
      <button type="button" data-size="m">M</button>
      <button type="button" data-size="l">L</button>
    </div>
  )}

  {files.length > 0 ? (
    <section class="gallery" data-size="m" aria-label="photos">
      {files.map((f) => (
        <a class="shot" href={`/photos/${f}`} target="_blank" rel="noopener">
          <img src={thumb(f)} alt="" loading="lazy" />
        </a>
      ))}
    </section>
  ) : (
    <p class="muted">no photos yet.</p>
  )}

  <style>
    .gallery-sizes { display: flex; justify-content: center; gap: 20px; margin: 0 0 22px; }
    .gallery-sizes button {
      background: none; border: none; padding: 0; cursor: pointer; font: inherit;
      font-size: 0.85rem; color: var(--faint); letter-spacing: 0.04em;
    }
    .gallery-sizes button:hover { color: var(--muted); }
    .gallery-sizes button[aria-pressed='true'] {
      color: var(--ink); text-decoration: underline; text-underline-offset: 4px;
    }

    .gallery {
      width: 100vw; position: relative; left: 50%; margin-left: -50vw;
      padding: 0 14px 28px;
      display: grid; gap: 10px;
    }
    .gallery[data-size='s'] { grid-template-columns: repeat(6, 1fr); }
    .gallery[data-size='m'] { grid-template-columns: repeat(4, 1fr); }
    .gallery[data-size='l'] { grid-template-columns: repeat(3, 1fr); }

    .shot { display: block; aspect-ratio: 1 / 1; overflow: hidden; background: var(--line); }
    .shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.2s ease; }
    .shot:hover img { opacity: 0.9; }

    @media (max-width: 900px) {
      .gallery[data-size='s'] { grid-template-columns: repeat(4, 1fr); }
      .gallery[data-size='m'] { grid-template-columns: repeat(3, 1fr); }
      .gallery[data-size='l'] { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .gallery[data-size='s'], .gallery[data-size='m'] { grid-template-columns: repeat(2, 1fr); }
      .gallery[data-size='l'] { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    const gallery = document.querySelector('.gallery');
    const sizeButtons = document.querySelectorAll('.gallery-sizes button');
    if (gallery && sizeButtons.length) {
      const apply = (size: string) => {
        gallery.setAttribute('data-size', size);
        sizeButtons.forEach((b) =>
          b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.size === size))
        );
        try { localStorage.setItem('gallery-size', size); } catch {}
      };
      let saved = 'm';
      try { saved = localStorage.getItem('gallery-size') || 'm'; } catch {}
      apply(saved);
      sizeButtons.forEach((b) =>
        b.addEventListener('click', () => apply((b as HTMLElement).dataset.size!))
      );
    }
  </script>
</Base>
