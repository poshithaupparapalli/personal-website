---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// everything dropped in public/photos becomes a frame in the viewer.
const photoDir = 'public/photos';
const files = fs.existsSync(photoDir)
  ? fs
      .readdirSync(photoDir)
      .filter((f) => /\.(jpe?g|png|webp|gif|avif)$/i.test(f))
      .sort()
  : [];

// seeded shuffle so the sequence is varied but stable between builds.
const rng = (() => {
  let s = 20260211;
  return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
})();
for (let i = files.length - 1; i > 0; i--) {
  const j = Math.floor(rng() * (i + 1));
  [files[i], files[j]] = [files[j], files[i]];
}

// captions (optional) — key is the exact filename.
const captions: Record<string, string> = {
  // '01_mongolia.jpg': 'wild horses outside ulaanbaatar',
};

const frames = files.map((f) => ({ src: `/photos/${f}`, cap: captions[f] ?? '' }));
---
<Base title="photography · poshitha">
  <h1 class="page-title">photography</h1>

  {frames.length > 0 ? (
    <div class="viewer">
      <div class="controls">
        <button type="button" id="prev">previous</button>
        <span class="slash">/</span>
        <button type="button" id="next">next</button>
        <span class="counter" id="counter"></span>
      </div>
      <figure class="stage">
        <img id="photo" alt="" />
        <figcaption class="cap" id="cap"></figcaption>
      </figure>
    </div>
  ) : (
    <p class="muted">no photos yet.</p>
  )}

  <style>
    .controls {
      display: flex; align-items: baseline; gap: 8px;
      margin: 20px 0 16px; font-size: 0.95rem;
    }
    .controls button {
      background: none; border: none; padding: 0; cursor: pointer;
      font: inherit; color: #3b5bd6;
    }
    .controls button:hover { text-decoration: underline; text-underline-offset: 2px; }
    .controls .slash { color: var(--faint); }
    .counter { color: var(--faint); font-size: 0.82rem; margin-left: 4px; }

    .stage { margin: 0; }
    .stage img {
      display: block; max-width: 100%; max-height: 74vh;
      width: auto; height: auto; border-radius: 4px;
    }
    .cap { margin-top: 12px; color: var(--muted); font-size: 0.85rem; }
  </style>

  <script define:vars={{ frames }}>
    const photo = document.getElementById('photo');
    if (photo && frames.length) {
      const counter = document.getElementById('counter');
      const cap = document.getElementById('cap');
      const prev = document.getElementById('prev');
      const next = document.getElementById('next');
      const n = frames.length;
      let i = 0;

      const show = () => {
        photo.src = frames[i].src;
        photo.alt = frames[i].cap || '';
        counter.textContent = `(${i + 1}/${n})`;
        cap.textContent = frames[i].cap || '';
      };
      const go = (d) => { i = (i + d + n) % n; show(); };

      prev.addEventListener('click', () => go(-1));
      next.addEventListener('click', () => go(1));
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') go(-1);
        if (e.key === 'ArrowRight') go(1);
      });
      show();
    }
  </script>
</Base>
