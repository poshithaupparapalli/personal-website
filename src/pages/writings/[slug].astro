---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writings');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toLowerCase();
---
<Base title={`${post.data.title} · poshitha`}>
  <h1 class="page-title">{post.data.title}</h1>
  <p class="lede">{fmt(post.data.date)}</p>
  <div class="prose">
    <Content />
  </div>
</Base>
