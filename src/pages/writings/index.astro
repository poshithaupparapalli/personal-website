---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writings')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase();
---
<Base title="writings · poshitha">
  <h1 class="page-title">writings</h1>
  <p class="lede">essays and notes.</p>

  {posts.length === 0 ? (
    <p class="muted">nothing published yet.</p>
  ) : (
    <ul class="ledger">
      {posts.map((p) => (
        <li>
          <span class="body">
            <a href={`/writings/${p.id}`}>{p.data.title}</a>
            {p.data.blurb && <span class="note">, {p.data.blurb}</span>}
          </span>
          <span class="meta">{fmt(p.data.date)}</span>
        </li>
      ))}
    </ul>
  )}
</Base>
