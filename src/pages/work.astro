---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// drop a square png/svg in public/logos/ named to match `logo` and it shows up
const logo = (name?: string) => {
  if (!name) return null;
  for (const ext of ['svg', 'png', 'jpg']) {
    if (fs.existsSync(`public/logos/${name}.${ext}`)) return `/logos/${name}.${ext}`;
  }
  return null;
};

const roles = [
  {
    role: 'software engineer',
    where: 'elevate',
    href: 'https://elevatevbsolutions.com/',
    logo: 'elevate',
    when: 'jun 2026 to now',
    note: '',
  },
  {
    role: 'investment intern',
    where: 'kidron capital',
    href: 'https://kidron-capital.com/wp-content/uploads/New_Kidron/kidron_homepage-2.html',
    logo: 'kidron',
    when: 'feb 2026 to now',
    note: "diligence on women's health and healthcare startups for a $25m fund. clinical workflows, regulatory paths, and the memos that go to the gps.",
  },
  {
    role: 'credit valuation intern',
    where: 'ford credit',
    href: 'https://credit.ford.com',
    logo: 'ford',
    when: 'may 2025 to jul 2025',
    note: 'survival and hazard modeling for default, payoff, and closure in sas. kaplan-meier curves, proportional hazard decision code, and baseline validation across three portfolio segments under ifrs 9.',
  },
  {
    role: 'tech lead',
    where: 'save tuba',
    href: 'https://savetuba.com/',
    logo: 'savetuba',
    when: 'jan 2025 to dec 2025',
    note: "one of five fellows sent to kazakhstan to rebuild save tuba's operating model. built the pricing and partnership models, and pitched a pilot across 100+ public schools.",
  },
  {
    role: 'fellow',
    where: 'the dexterity global group',
    href: 'https://www.dexterityglobal.org/',
    logo: 'dexterity',
    when: 'dec 2021 to now',
    note: '',
  },
];

const campus = [
  {
    role: 'fellow',
    where: 'lehigh startup academy',
    href: 'https://360.lehigh.edu/programs/startup-academy',
    when: 'may 2026 to now',
    note: '',
  },
  {
    role: 'vp of membership experience',
    where: 'scholars of finance, lehigh',
    href: 'https://www.scholarsoffinance.org',
    when: 'apr 2025 to now',
    note: 'recruitment and onboarding for an 85-member chapter.',
  },
  {
    role: 'founder + research lead',
    where: 'the sof research rundown',
    href: 'https://lehighscholarsoffinance.substack.com/i/191091144/the-repricing-of-who-controls-ai-infrastructure',
    when: 'jan 2026 to now',
    note: 'm&a, macro, and private markets',
  },
  {
    role: 'resident assistant',
    where: 'lehigh university',
    when: 'aug 2025 to now',
    note: '',
  },
  {
    role: 'vc analyst',
    where: 'tamid vc',
    href: 'https://www.linkedin.com/company/lehightamid/posts/?feedView=all',
    when: 'jan 2026 to now',
    note: '',
  },
  {
    role: 'secretary',
    where: 'south asian student association',
    href: 'https://www.instagram.com/lehigh_sasa/',
    when: 'mar 2025 to may 2026',
    note: '',
  },
];
---
<Base title="work · poshitha">
  <h1 class="page-title">work</h1>

  <ul class="roles">
    {roles.map((r) => (
      <li>
        <div class="row">
          {logo(r.logo) ? (
            <img class="mark" src={logo(r.logo)} alt="" />
          ) : (
            <span class="mark blank" />
          )}
          <div class="text">
            <div class="head">
              <span class="role">{r.role}</span>
              <span class="when">{r.when}</span>
            </div>
            <p class="where">
              {r.href ? (
                <a href={r.href} target="_blank" rel="noopener">{r.where}</a>
              ) : (
                r.where
              )}
            </p>
            {r.note && <p class="note">{r.note}</p>}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <h2>at lehigh</h2>
  <ul class="roles">
    {campus.map((r) => (
      <li>
        <div class="row">
          <span class="mark blank" />
          <div class="text">
            <div class="head">
              <span class="role">{r.role}</span>
              <span class="when">{r.when}</span>
            </div>
            <p class="where">
              {r.href ? (
                <a href={r.href} target="_blank" rel="noopener">{r.where}</a>
              ) : (
                r.where
              )}
            </p>
            {r.note && <p class="note">{r.note}</p>}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <style>
    .roles { list-style: none; margin: 0; padding: 0; }
    .roles li { padding: 22px 0; border-bottom: 1px solid var(--line); }
    .roles li:last-child { border-bottom: none; }

    .row { display: flex; gap: 16px; align-items: flex-start; }
    .mark {
      width: 30px; height: 30px; flex-shrink: 0; border-radius: 6px;
      object-fit: contain; margin-top: 2px;
    }
    .mark.blank { visibility: hidden; }
    .text { flex: 1; min-width: 0; }

    .head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 16px; flex-wrap: wrap;
    }
    .role { font-weight: 600; font-size: 1.05rem; }
    .when { color: var(--faint); font-size: 0.85rem; flex-shrink: 0; }
    .where { color: var(--muted); margin: 1px 0 0; }
    .note { color: var(--muted); margin: 10px 0 0; max-width: 62ch; font-size: 0.95rem; }

    h2 { font-size: 1rem; font-weight: 600; margin: 46px 0 4px; }

    @media (max-width: 600px) {
      .mark, .mark.blank { display: none; }
      .row { gap: 0; }
    }
  </style>
</Base>
