---
import Base from '../layouts/Base.astro';

const roles = [
  {
    what: 'elevate',
    note: 'software engineer',
    when: 'now',
    href: 'https://elevatevbsolutions.com/',
  },
  {
    what: 'kidron',
    note: 'vc analyst',
    when: 'now',
    href: 'https://kidron-capital.com/wp-content/uploads/New_Kidron/kidron_homepage-2.html',
  },
  {
    what: 'ford credit',
    note: 'built credit risk models',
    when: 'summer 2025',
    href: 'https://credit.ford.com',
  },
];

const campus = [
  {
    what: 'scholars of finance',
    note: 'vp of member experience, lehigh chapter',
    href: 'https://www.scholarsoffinance.org',
  },
  {
    what: 'the research rundown',
    note: "founder + research lead — what's moving in the markets, broken down",
    href: 'https://lehighscholarsoffinance.substack.com/i/191091144/the-repricing-of-who-controls-ai-infrastructure',
  },
  { what: 'stem housing', note: 'resident assistant' },
  {
    what: 'south asian student association',
    note: 'secretary',
    href: 'https://www.instagram.com/lehigh_sasa/',
  },
];
---
<Base title="work · poshitha">
  <h1 class="page-title">work</h1>

  <ul class="ledger">
    {roles.map((r) => (
      <li>
        <span class="body">
          {r.href ? (
            <a href={r.href} target="_blank" rel="noopener"><strong>{r.what}</strong></a>
          ) : (
            <strong>{r.what}</strong>
          )}
          <span class="note"> — {r.note}</span>
        </span>
        <span class="meta">{r.when}</span>
      </li>
    ))}
  </ul>

  <h2>at lehigh</h2>
  <ul class="ledger">
    {campus.map((c) => (
      <li>
        <span class="body">
          {c.href ? (
            <a href={c.href} target="_blank" rel="noopener"><strong>{c.what}</strong></a>
          ) : (
            <strong>{c.what}</strong>
          )}
          <span class="note"> — {c.note}</span>
        </span>
      </li>
    ))}
  </ul>

  <style>
    h2 { font-size: 1rem; font-weight: 600; margin: 44px 0 12px; }
  </style>
</Base>
