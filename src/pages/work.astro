---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// drop a square png/svg in public/logos/ named to match `logo` and it shows up
const logo = (name?: string) => {
  if (!name) return null;
  for (const ext of ['svg', 'png', 'jpg']) {
    if (fs.existsSync(`public/logos/${name}.${ext}`)) return `/logos/${name}.${ext}`;
  }
  return null;
};

// one entry per company; a company can hold more than one role
const experience = [
  {
    where: 'samsung research america',
    href: 'https://sra.samsung.com/',
    logo: 'samsung',
    roles: [{ role: 'emerging tech analyst', when: 'aug 2026 to now', note: "helping invest + research in women's health, biotech, and consumer tech" }],
  },
  {
    where: 'lehigh university',
    href: 'https://www2.lehigh.edu/',
    logo: 'lehigh',
    roles: [{ role: 'deep learning research assistant', when: 'sep 2026 to now', note: 'bina lab under prof. rahnemoonfar' }],
  },
  {
    where: 'scholars of finance',
    href: 'https://www.lehighsof.org/',
    logo: 'sof',
    roles: [
      { role: 'research lead', when: 'mar 2026 to now', noteText: 'the research rundown', noteHref: 'https://lehighscholarsoffinance.substack.com/' },
      { role: 'vp, member experience', when: 'dec 2025 to now' },
    ],
  },
  {
    where: 'ancora robotics',
    href: 'https://www.linkedin.com/company/ancora-robotics/',
    logo: 'ancora',
    roles: [{ role: 'co-founder', when: 'aug 2026 to now', note: 'autonomous robots for guarding undersea cables and data centers' }],
  },
  {
    where: 'kidron capital',
    href: 'https://kidron-capital.com/wp-content/uploads/New_Kidron/kidron_homepage-2.html',
    logo: 'kidron',
    roles: [{ role: 'investment analyst', when: 'feb 2026 to now' }],
  },
  {
    where: 'elevate',
    href: 'https://elevatevbsolutions.com/',
    logo: 'elevate',
    roles: [{ role: 'software engineer', when: 'may 2026 to jul 2026' }],
  },
  {
    where: 'save tuba',
    href: 'https://savetuba.com/',
    logo: 'savetuba',
    roles: [{ role: 'tech lead', when: 'jan 2025 to dec 2025' }],
  },
  {
    where: 'ford credit',
    href: 'https://credit.ford.com/',
    logo: 'ford',
    roles: [{ role: 'quantitative credit risk intern', when: 'may 2025 to jul 2025' }],
  },
  {
    where: 'the dexterity global group',
    href: 'https://www.dexterityglobal.org/',
    logo: 'dexterity',
    roles: [{ role: 'fellow', when: 'dec 2021 to now' }],
  },
];
---
<Base title="work · poshitha">
  <h1 class="page-title">work</h1>

  <ul class="roles">
    {experience.map((c) => {
      const grouped = c.roles.length > 1;
      return (
        <li>
          <div class="row">
            {logo(c.logo) ? (
              <img class="mark" src={logo(c.logo)} alt="" />
            ) : (
              <span class="mark blank" />
            )}
            <div class="text">
              {grouped && (
                <p class="company">
                  {c.href ? <a href={c.href} target="_blank" rel="noopener">{c.where}</a> : c.where}
                </p>
              )}
              {c.roles.map((r) => (
                <div class={grouped ? 'sub' : ''}>
                  <div class="head">
                    <span class="role">{r.role}</span>
                    <span class="when">{r.when}</span>
                  </div>
                  {!grouped && (
                    <p class="where">
                      {c.href ? <a href={c.href} target="_blank" rel="noopener">{c.where}</a> : c.where}
                    </p>
                  )}
                  {r.note ? (
                    <p class="note">{r.note}</p>
                  ) : r.noteText ? (
                    <p class="note">
                      {r.noteHref ? <a href={r.noteHref} target="_blank" rel="noopener">{r.noteText}</a> : r.noteText}
                    </p>
                  ) : null}
                </div>
              ))}
            </div>
          </div>
        </li>
      );
    })}
  </ul>

  <style>
    .roles { list-style: none; margin: 0; padding: 0; }
    .roles li { padding: 22px 0; border-bottom: 1px solid var(--line); }
    .roles li:last-child { border-bottom: none; }

    .row { display: flex; gap: 16px; align-items: flex-start; }
    /* a white chip keeps dark logos (like the sof mark) visible in dark mode */
    .mark {
      width: 34px; height: 34px; flex-shrink: 0; border-radius: 7px;
      object-fit: contain; background: #fff; padding: 3px;
      border: 1px solid var(--line); margin-top: 2px;
    }
    .mark.blank { visibility: hidden; }
    .text { flex: 1; min-width: 0; }

    .company { font-weight: 600; font-size: 1.05rem; margin: 0 0 10px; }
    .company a { text-decoration-color: var(--faint); }

    /* nested roles under a grouped company get a quiet left rail */
    .sub {
      padding-left: 14px; border-left: 1px solid var(--line);
      margin-top: 14px;
    }
    .sub:first-of-type { margin-top: 0; }

    .head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 16px; flex-wrap: wrap;
    }
    .role { font-weight: 600; font-size: 1.05rem; }
    .sub .role { font-weight: 500; font-size: 1rem; }
    .when { color: var(--faint); font-size: 0.85rem; flex-shrink: 0; }
    .where { color: var(--muted); margin: 1px 0 0; }
    .note { color: var(--muted); margin: 8px 0 0; max-width: 62ch; font-size: 0.95rem; }

    @media (max-width: 600px) {
      .mark, .mark.blank { display: none; }
      .row { gap: 0; }
    }
  </style>
</Base>
