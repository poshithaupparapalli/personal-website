---
import Base from '../layouts/Base.astro';

const projects = [
  {
    name: 'ai for small-business owners',
    note: 'building the whole application out with a very cool founder. details soon.',
    when: '2026 · in progress',
  },
];
---
<Base title="projects · poshitha">
  <h1 class="page-title">projects</h1>
  <p class="lede"></p>

  <ul class="ledger">
    {projects.map((p, i) => (
      <li>
        <span class="no mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="body">
          <strong>{p.name}</strong>
          <span class="note"> — {p.note}</span>
        </span>
        <span class="meta mono">{p.when}</span>
      </li>
    ))}
  </ul>
</Base>
