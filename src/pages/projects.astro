---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// drop a screenshot in public/projects/ named to match `shot` and it replaces
// the blank slot automatically.
const shot = (name: string) => {
  for (const ext of ['png', 'jpg', 'jpeg', 'webp', 'gif', 'avif']) {
    if (fs.existsSync(`public/projects/${name}.${ext}`)) return `/projects/${name}.${ext}`;
  }
  return null;
};

// newest first. tagline = the short phrase next to the title; desc = the longer
// write-up under it (yours to fill in).
const projects = [
  {
    name: 'seismocardiography',
    shot: 'seismocardiography',
    href: '',
    tagline: 'ecg-free heart monitoring',
    meta: 'taebi lab · 2026',
    desc: '',
  },
  {
    name: 'mobile robotics',
    shot: 'robotics',
    href: '',
    tagline: 'autonomous robots on real hardware',
    meta: 'cse 360 · 2026',
    desc: '',
  },
  {
    name: 'coalesce',
    shot: 'coalesce',
    href: 'https://github.com/kentneureiter/coalesce',
    tagline: 'keeping coding agents in sync',
    meta: 'aws hackathon · 2026',
    desc: '',
  },
  {
    name: 'tara',
    shot: 'tara',
    href: 'https://github.com/kripahsk-29/startup-school-hackathon-2026',
    tagline: 'can ai learn your taste?',
    meta: 'yc startup school · 2026',
    desc: '',
  },
  {
    name: 'mia',
    shot: 'mia',
    href: 'https://github.com/poshithaupparapalli/hackmit-project2',
    tagline: 'automating the busywork',
    meta: 'hackmit · 2026',
    desc: '',
  },
  {
    name: 'resonance',
    shot: 'resonance',
    href: 'https://github.com/poshithaupparapalli/yournewsreal',
    tagline: 'a news feed that learns you',
    meta: '2026',
    desc: '',
  },
  {
    name: 'raiseit',
    shot: 'raiseit',
    href: 'https://github.com/poshithaupparapalli/raiseit',
    tagline: 'tracking raised hands with cv',
    meta: '2025',
    desc: '',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---
<Base title="projects · poshitha">
  <h1 class="page-title">projects</h1>

  <div class="projects">
    {projects.map((p) => {
      const img = shot(p.shot);
      const ext = isExternal(p.href);
      const media = img ? (
        <img src={img} alt={p.name} loading="lazy" />
      ) : (
        <span class="ph">{p.name}</span>
      );
      return (
        <article class="project">
          <div class="shot">
            {p.href ? (
              <a href={p.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{media}</a>
            ) : (
              media
            )}
          </div>
          <div class="body">
            <div class="head">
              <span class="titleline">
                <span class="name">
                  {p.href ? (
                    <a href={p.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{p.name}</a>
                  ) : (
                    p.name
                  )}
                </span>
                {p.tagline && <span class="tagline">{p.tagline}</span>}
              </span>
              {p.meta && <span class="date">{p.meta}</span>}
            </div>
            {p.desc && <p class="desc">{p.desc}</p>}
          </div>
        </article>
      );
    })}
  </div>

  <style>
    .projects { display: flex; flex-direction: column; gap: 48px; margin-top: 8px; }
    .project { display: grid; grid-template-columns: 300px 1fr; gap: 28px; align-items: start; }

    .shot a, .shot img, .shot .ph { display: block; }
    .shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; }
    .ph {
      width: 100%; aspect-ratio: 16 / 10; border-radius: 10px; background: var(--line);
      display: flex; align-items: center; justify-content: center;
      color: var(--faint); font-size: 0.9rem;
    }

    .head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 16px; margin-top: 2px;
    }
    .titleline { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .name { font-weight: 600; font-size: 1.05rem; }
    .name a { color: var(--ink); text-decoration: none; }
    .name a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .tagline { color: var(--muted); font-size: 0.92rem; }
    .date { color: var(--faint); font-size: 0.8rem; white-space: nowrap; flex-shrink: 0; }

    .desc { margin: 10px 0 0; color: var(--muted); font-size: 0.92rem; max-width: 62ch; }

    @media (max-width: 620px) {
      .project { grid-template-columns: 1fr; gap: 12px; }
      .head { flex-direction: column; gap: 2px; }
    }
  </style>
</Base>
