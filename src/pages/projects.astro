---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// drop a screenshot in public/projects/ named to match `shot` and it shows up
const shot = (name: string) => {
  for (const ext of ['png', 'jpg', 'jpeg', 'webp', 'gif']) {
    if (fs.existsSync(`public/projects/${name}.${ext}`)) return `/projects/${name}.${ext}`;
  }
  return null;
};

// newest first. dates are starting points from each repo — easy to correct.
const projects = [
  {
    name: 'coalesce',
    shot: 'coalesce',
    href: 'https://github.com/kentneureiter/coalesce',
    date: 'oct 2026',
  },
  {
    name: 'mia',
    shot: 'mia',
    href: 'https://github.com/poshithaupparapalli/hackmit-project2',
    date: 'sep 2026',
  },
  {
    name: 'tara',
    shot: 'tara',
    href: 'https://github.com/kripahsk-29/startup-school-hackathon-2026',
    date: 'jul 2026',
  },
  {
    name: 'resonance',
    shot: 'resonance',
    href: 'https://github.com/poshithaupparapalli/yournewsreal',
    date: 'mar 2026',
  },
  {
    name: 'sof family trees',
    shot: 'familytrees',
    href: 'https://poshithaupparapalli.github.io/SoF-family-trees/',
    date: 'mar 2026',
  },
  {
    name: 'parkalot',
    shot: 'parkalot',
    href: 'https://github.com/poshithaupparapalli/parking_lot_lehigh_hackathon',
    date: 'oct 2025',
  },
  {
    name: 'raiseit',
    shot: 'raiseit',
    href: 'https://github.com/poshithaupparapalli/raiseit',
    date: 'jun 2025',
  },
  {
    name: 'dijkstra vs bellman-ford',
    shot: 'ee',
    href: '/dijkstra-vs-bellman-ford.pdf',
    date: '2023',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---
<Base title="projects · poshitha">
  <h1 class="page-title">projects</h1>

  <ul class="grid">
    {projects.map((p) => (
      <li>
        <a
          href={p.href}
          target={isExternal(p.href) ? '_blank' : undefined}
          rel={isExternal(p.href) ? 'noopener' : undefined}
        >
          <div class="thumb">
            {shot(p.shot) ? (
              <img src={shot(p.shot)} alt={p.name} loading="lazy" />
            ) : (
              <span class="placeholder">{p.name}</span>
            )}
          </div>
          <div class="title">{p.name}</div>
          {p.date && <div class="date">{p.date}</div>}
        </a>
      </li>
    ))}
  </ul>

  <p class="more">
    <a href="https://github.com/poshithaupparapalli?tab=repositories" target="_blank" rel="noopener">
      everything else on github
    </a>
  </p>

  <style>
    .grid {
      list-style: none; margin: 0; padding: 0;
      display: grid; gap: 40px 28px;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    }
    .grid a { display: block; text-decoration: none; }

    .thumb {
      aspect-ratio: 3 / 2; overflow: hidden; border-radius: 8px;
      border: 1px solid var(--line); background: var(--pop);
      display: flex; align-items: center; justify-content: center;
    }
    .thumb img {
      width: 100%; height: 100%; object-fit: cover; object-position: top;
      display: block; transition: transform 0.35s ease;
    }
    .grid a:hover .thumb img { transform: scale(1.03); }
    .placeholder {
      font-size: 1.15rem; color: var(--faint); letter-spacing: 0.01em;
    }

    .title { margin-top: 12px; font-weight: 500; color: var(--ink); }
    .grid a:hover .title { color: var(--accent, var(--ink)); }
    .date { margin-top: 2px; font-size: 0.85rem; color: var(--faint); }

    .more { margin: 48px 0 0; }
    .more a { color: var(--muted); }
  </style>
</Base>
