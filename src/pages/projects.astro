---
import Base from '../layouts/Base.astro';

// a plain list: name, a category + year on the right, one line underneath.
// no thumbnails, no cards — just the work.
const projects = [
  {
    name: 'coalesce',
    href: 'https://github.com/kentneureiter/coalesce',
    tag: 'multi-agent',
    year: '2026',
    blurb:
      'a shared floor for coding agents — each one sees what the others just changed, so nobody ends up writing against a stale codebase.',
  },
  {
    name: 'mia',
    href: 'https://github.com/poshithaupparapalli/hackmit-project2',
    tag: 'hackmit',
    year: '2026',
    blurb: '', // TODO: one line on what mia does
  },
  {
    name: 'tara',
    href: 'https://github.com/kripahsk-29/startup-school-hackathon-2026',
    tag: 'hackathon',
    year: '2026',
    blurb: '', // TODO: one line on what tara does
  },
  {
    name: 'resonance',
    href: 'https://github.com/poshithaupparapalli/yournewsreal',
    tag: 'news · ml',
    year: '2026',
    blurb:
      'a personalized news engine that pulls and ranks articles from 8+ sources every hour — cosine similarity, entity matching, and novelty, tuned by how you actually read.',
  },
  {
    name: 'sof family trees',
    href: 'https://poshithaupparapalli.github.io/SoF-family-trees/',
    tag: 'data viz',
    year: '2026',
    blurb: 'an interactive family tree of scholars of finance — who mentored whom across the chapters.',
  },
  {
    name: 'parkalot',
    href: 'https://github.com/poshithaupparapalli/parking_lot_lehigh_hackathon',
    tag: 'hackathon',
    year: '2025',
    blurb: "find open parking on lehigh's campus in real time. built in a weekend.",
  },
  {
    name: 'raiseit',
    href: 'https://github.com/poshithaupparapalli/raiseit',
    tag: '',
    year: '2025',
    blurb: '', // TODO: one line on what raiseit does
  },
  {
    name: 'dijkstra vs bellman-ford',
    href: '/dijkstra-vs-bellman-ford.pdf',
    tag: 'essay',
    year: '2023',
    blurb: 'a short write-up comparing two shortest-path algorithms — when each one wins.',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---
<Base title="projects · poshitha">
  <h1 class="page-title">projects</h1>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="row">
          <a
            class="name"
            href={p.href}
            target={isExternal(p.href) ? '_blank' : undefined}
            rel={isExternal(p.href) ? 'noopener' : undefined}
          >
            {p.name} <span class="arr">↗</span>
          </a>
          <span class="meta">{[p.tag, p.year].filter(Boolean).join(' · ')}</span>
        </div>
        {p.blurb && <p class="blurb">{p.blurb}</p>}
      </li>
    ))}
  </ul>

  <style>
    .projects { list-style: none; margin: 0; padding: 0; }
    .projects li { padding: 22px 0; border-bottom: 1px solid var(--line); }
    .projects li:last-child { border-bottom: none; }

    .row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
    .name {
      font-weight: 500; color: var(--ink); text-decoration: none;
      text-underline-offset: 3px;
    }
    .name:hover { text-decoration: underline; text-decoration-color: var(--faint); }
    .arr { color: var(--faint); font-size: 0.8em; }
    .meta { color: var(--faint); font-size: 0.8rem; flex-shrink: 0; white-space: nowrap; }

    .blurb { margin: 6px 0 0; color: var(--muted); font-size: 0.9rem; max-width: 60ch; }

    @media (max-width: 520px) {
      .row { flex-direction: column; gap: 2px; }
    }
  </style>
</Base>
