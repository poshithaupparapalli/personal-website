---
import Base from '../layouts/Base.astro';

// text-only list: monospace title, context + year, then a short write-up.
// newest first.
const projects = [
  {
    title: 'ECG-independent cardiac event detection',
    meta: 'Taebi Lab · 2026',
    href: '',
    desc: 'Developing a signal-processing and deep learning pipeline to detect aortic valve opening (AO) and mitral valve closure (MC) directly from seismocardiogram (SCG) recordings, without ECG-based segmentation. Built an annotation reconciliation pipeline across four datasets to establish consensus ground truth from three annotators. Currently evaluating template-matching and 1D U-Net baselines, with a focus on subject-independent evaluation and generalization across variations in cardiac signal morphology.',
  },
  {
    title: 'Autonomous navigation and perception',
    meta: 'CSE 360 · 2026',
    href: '',
    desc: 'Implemented a vision-based line-following system on a Moorebot Scout using HSV color segmentation, RANSAC line estimation, and dual PID controllers for closed-loop steering. Developed sonar-based wall following with deliberately corrupted distance measurements, and a calibrated stereo vision pipeline using OpenCV, achieving 0.72-pixel reprojection error.',
  },
  {
    title: 'Multi-agent code synchronization',
    meta: 'AWS Hackathon · 2026',
    href: 'https://github.com/kentneureiter/coalesce',
    desc: "Built a coordination layer for parallel coding agents operating on shared repositories. Claude Code hooks capture branch-level diffs, Python AST analysis extracts function-level changes, and relevant modifications are propagated between agents to reduce stale-context conflicts before integration. Won Most Innovative Project at Lehigh's AWS Hackathon.",
  },
  {
    title: 'Pairwise human preference evaluation',
    meta: 'YC Startup School · 2026',
    href: 'https://github.com/kripahsk-29/startup-school-hackathon-2026',
    desc: 'Developed an evaluation framework for measuring how accurately generative AI models predict individual visual preferences using pairwise image comparisons. Built the live judging interface, human evaluation harness, and scoring pipeline to compare model predictions against responses from a 25-person panel. Second place in the Terac track.',
  },
  {
    title: 'Agentic browser workflow automation',
    meta: 'HackMIT · 2026',
    href: 'https://github.com/poshithaupparapalli/hackmit-project2',
    desc: 'Built a browser-based agent for identifying and executing repetitive workflows across web applications. Developed the task execution layer and Google Workspace integrations to automate multi-step operations involving Gmail and Sheets, transforming repeated browser interactions into reusable, one-click workflows.',
  },
  {
    title: 'Personalized information retrieval and recommendation',
    meta: '2026',
    href: 'https://github.com/poshithaupparapalli/yournewsreal',
    desc: 'Built a personalized news retrieval pipeline ingesting 500+ articles daily from RSS feeds and the Guardian API. Uses OpenAI embeddings and Leiden community detection on a similarity graph to cluster semantically related coverage, followed by cosine-similarity ranking against user interest vectors derived from free-text onboarding responses. Currently serving 50+ readers through personalized daily briefings.',
  },
  {
    title: 'Scholars of Finance family trees',
    meta: '2026',
    href: 'https://poshithaupparapalli.github.io/SoF-family-trees/',
    desc: '',
  },
  {
    title: 'Real-time multi-person detection and tracking',
    meta: '2025–26',
    href: 'https://github.com/poshithaupparapalli/raiseit',
    desc: 'Developed a real-time computer vision pipeline for detecting and tracking raised hands in crowded lecture halls using a fine-tuned YOLOv8 detector for multi-object association.',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---
<Base title="Projects · Poshitha">
  <h1 class="page-title">Projects</h1>

  <ul class="projects">
    {projects.map((p) => {
      const ext = isExternal(p.href);
      return (
        <li class="project">
          <div class="name">
            {p.href ? (
              <a href={p.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{p.title}</a>
            ) : (
              <span>{p.title}</span>
            )}
          </div>
          {p.meta && <div class="meta">{p.meta}</div>}
          {p.desc && <p class="desc">{p.desc}</p>}
        </li>
      );
    })}
  </ul>

  <p class="more">
    <a href="https://github.com/poshithaupparapalli" target="_blank" rel="noopener">More on GitHub →</a>
  </p>

  <style>
    .projects { list-style: none; margin: 0; padding: 0; }
    .project { padding: 26px 0; border-top: 1px solid var(--line); }
    .project:first-child { border-top: none; padding-top: 10px; }

    .name {
      font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      font-weight: 600; font-size: 0.95rem;
    }
    .name a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
    .name a:hover { color: var(--muted); }
    .meta { color: var(--faint); font-size: 0.82rem; margin: 4px 0 10px; }

    .desc { margin: 0; color: var(--ink); font-size: 0.95rem; max-width: 64ch; }

    .more { margin: 36px 0 0; }
    .more a { color: var(--muted); }
  </style>
</Base>
