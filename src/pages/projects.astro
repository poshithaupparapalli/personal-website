---
import Base from '../layouts/Base.astro';

// text-only list: monospace title, context + year, then a short write-up.
// newest first.
const projects = [
  {
    title: 'ecg-free cardiac event detection',
    meta: 'taebi lab · 2026',
    href: '',
    desc: 'developing an ecg-independent approach to detecting aortic valve opening (ao) and mitral valve closure (mc) from seismocardiography (scg) signals. on a three-person research team, i developed an annotation reconciliation pipeline to establish ground-truth labels across four datasets and am benchmarking template matching and 1d u-net models for cross-subject generalization.',
  },
  {
    title: 'autonomous navigation and perception',
    meta: 'cse 360 · 2026',
    href: '',
    desc: 'implemented autonomous navigation and perception algorithms on robotic platforms, including a vision-based line follower using hsv segmentation, ransac line fitting, and dual pid controllers tuned in simulation. also developed sonar-based wall following under corrupted sensor measurements and calibrated an opencv stereo vision pipeline to 0.72-pixel reprojection error.',
  },
  {
    title: 'multi-agent code synchronization',
    meta: 'aws hackathon · 2026',
    href: 'https://github.com/kentneureiter/coalesce',
    desc: "developed a synchronization system for parallel coding agents to reduce conflicts arising from stale repository state. integrated claude code hooks to capture branch-level diffs, used python ast analysis to identify function-level changes, and distributed relevant updates across agents. awarded most innovative project at lehigh's aws hackathon.",
  },
  {
    title: 'human preference evaluation for generative ai',
    meta: 'yc startup school · 2026',
    href: 'https://github.com/kripahsk-29/startup-school-hackathon-2026',
    desc: "built a pairwise evaluation framework to measure how accurately ai models predict individual visual preferences. developed the judging interface, evaluation harness, and scoring pipeline for a live study with 25 participants. built in eight hours and awarded second place in the terac track at yc startup school's hackathon.",
  },
  {
    title: 'agentic browser workflow automation',
    meta: 'hackmit · 2026',
    href: 'https://github.com/poshithaupparapalli/hackmit-project2',
    desc: 'developed a browser-based automation agent that identifies repetitive workflows and enables one-click execution across web applications. implemented the task execution agent and google workspace integrations to automate workflows involving gmail and google sheets. built a working prototype in 15 hours at hackmit.',
  },
  {
    title: 'personalized news recommendation and clustering',
    meta: '2026',
    href: 'https://github.com/poshithaupparapalli/yournewsreal',
    desc: 'co-founded an ai-powered news platform delivering personalized daily briefings to 50+ readers. built an information retrieval pipeline ingesting 500+ articles daily, using openai embeddings and leiden graph clustering to group related coverage. implemented interest-based recommendation ranking to personalize news feeds from user onboarding preferences.',
  },
  {
    title: 'scholars of finance family trees',
    meta: '2026',
    href: 'https://poshithaupparapalli.github.io/SoF-family-trees/',
    desc: '',
  },
  {
    title: 'real-time hand-raising detection and tracking',
    meta: '2025–26',
    href: 'https://github.com/poshithaupparapalli/raiseit',
    desc: 'developed a computer vision system for detecting and tracking raised hands in crowded lecture halls using yolov8.',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---
<Base title="projects · poshitha">
  <h1 class="page-title">projects</h1>

  <ul class="projects">
    {projects.map((p) => {
      const ext = isExternal(p.href);
      return (
        <li class="project">
          <div class="name">
            {p.href ? (
              <a href={p.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{p.title}</a>
            ) : (
              <span>{p.title}</span>
            )}
          </div>
          {p.meta && <div class="meta">{p.meta}</div>}
          {p.desc && <p class="desc">{p.desc}</p>}
        </li>
      );
    })}
  </ul>

  <p class="more">
    <a href="https://github.com/poshithaupparapalli" target="_blank" rel="noopener">more on github →</a>
  </p>

  <style>
    .projects { list-style: none; margin: 0; padding: 0; }
    .project { padding: 26px 0; border-top: 1px solid var(--line); }
    .project:first-child { border-top: none; padding-top: 10px; }

    .name {
      font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
      font-weight: 700; font-size: 0.95rem;
    }
    .name a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
    .name a:hover { color: var(--muted); }
    .meta { color: var(--faint); font-size: 0.82rem; margin: 4px 0 10px; }

    .desc { margin: 0; color: var(--ink); font-size: 0.95rem; max-width: 64ch; }

    .more { margin: 36px 0 0; }
    .more a { color: var(--muted); }
  </style>
</Base>
