---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

// drop a screenshot in public/projects/ named to match `shot` and it replaces
// the blank slot automatically.
const shot = (name: string) => {
  for (const ext of ['png', 'jpg', 'jpeg', 'webp', 'gif', 'avif']) {
    if (fs.existsSync(`public/projects/${name}.${ext}`)) return `/projects/${name}.${ext}`;
  }
  return null;
};

// newest first.
const projects = [
  {
    name: 'seismocardiography',
    shot: 'seismocardiography',
    href: '',
    meta: 'deep learning research · taebi lab · sep 2026 – present',
    desc: "ecg-free heart monitoring from chest vibrations. every heartbeat makes your chest vibrate a little — a cheap motion sensor, even a phone, can catch it, and buried in there is the moment your aortic valve opens, which says a lot about how well your heart is pumping. i'm on a 3-person team in dr. taebi's lab at lehigh trying to drop the ecg entirely: i've labeled heartbeats across four datasets, built the tooling that merges our three annotators into one ground truth, and we're now benchmarking the main published methods before training our own model that has to hold up on people it's never seen.",
  },
  {
    name: 'mobile robotics',
    shot: 'robotics',
    href: '',
    meta: 'lehigh cse 360 · fall 2026',
    desc: "a semester of autonomous mobile robotics, all built around one loop: sense a noisy world, estimate what's actually true, then act on it. the main project was a vision-based line follower on a real moorebot scout — hsv tape segmentation, ransac line fitting, and two pid controllers (omnidirectional strafe vs. forward + turn) validated in simulation before live deployment. earlier i built a wall-following controller for a 30-sonar robot under gaussian noise and 25% multipath outliers (ransac over least squares to kill a ~0.2m steady-state offset), and calibrated a stereo depth pipeline in opencv to 0.72px reprojection error.",
  },
  {
    name: 'coalesce',
    shot: 'coalesce',
    href: 'https://github.com/kentneureiter/coalesce',
    meta: 'aws hackathon · oct 2026',
    desc: "a system that keeps parallel coding agents in sync — claude code hooks capture each branch's diffs, pull out the function-level changes with python ast, and hand that context to the other agents before conflicting edits ever reach review. won most innovative project at lehigh's aws hackathon.",
  },
  {
    name: 'tara',
    shot: 'tara',
    href: 'https://github.com/kripahsk-29/startup-school-hackathon-2026',
    meta: 'yc startup school hackathon · jul 2026',
    desc: 'a benchmark for whether ai can replicate your personal visual taste, through pairwise human evaluation. built the eval harness, judging ui, and scoring pipeline for a 25-person live panel in 8 hours — 2nd place in the terac track.',
  },
  {
    name: 'mia',
    shot: 'mia',
    href: 'https://github.com/poshithaupparapalli/hackmit-project2',
    meta: 'hackmit · 2026',
    desc: '', // TODO: one line on what mia does
  },
  {
    name: 'resonance',
    shot: 'resonance',
    href: 'https://github.com/poshithaupparapalli/yournewsreal',
    meta: 'mar 2026 – present',
    desc: 'a personalized ai news platform sending daily briefings to 50+ readers. pulls 500+ articles a day and clusters them with openai embeddings + leiden graphs to dedupe coverage, then learns your taste from a quick onboarding. co-founded.',
  },
  {
    name: 'raiseit',
    shot: 'raiseit',
    href: 'https://github.com/poshithaupparapalli/raiseit',
    meta: '2025',
    desc: 'a computer vision system that detects and tracks raised hands in big lecture halls (yolov8 + bytetrack). fine-tuned on 300+ annotated images and deployed across five classrooms at lehigh on a jetson orin nano.',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---
<Base title="projects · poshitha">
  <h1 class="page-title">projects</h1>

  <div class="projects">
    {projects.map((p) => {
      const img = shot(p.shot);
      const ext = isExternal(p.href);
      const media = img ? (
        <img src={img} alt={p.name} loading="lazy" />
      ) : (
        <span class="ph">{p.name}</span>
      );
      return (
        <article class="project">
          <div class="shot">
            {p.href ? (
              <a href={p.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                {media}
              </a>
            ) : (
              media
            )}
          </div>
          <div class="body">
            <h2 class="name">
              {p.href ? (
                <a href={p.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{p.name}</a>
              ) : (
                p.name
              )}
            </h2>
            {p.meta && <div class="meta">{p.meta}</div>}
            {p.desc && <p class="desc">{p.desc}</p>}
          </div>
        </article>
      );
    })}
  </div>

  <style>
    .projects { display: flex; flex-direction: column; gap: 56px; margin-top: 6px; }
    .project { display: grid; grid-template-columns: 300px 1fr; gap: 30px; align-items: start; }

    .shot a, .shot img, .shot .ph { display: block; }
    .shot img {
      width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 6px;
    }
    .ph {
      width: 100%; aspect-ratio: 3 / 2; border-radius: 6px; background: var(--line);
      display: flex; align-items: center; justify-content: center;
      color: var(--faint); font-size: 0.9rem;
    }

    .name { font-size: 1.05rem; font-weight: 600; margin: 0 0 3px; }
    .name a { color: var(--ink); text-decoration: none; }
    .name a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .meta { color: var(--faint); font-size: 0.82rem; margin: 0 0 10px; }
    .desc { color: var(--muted); font-size: 0.9rem; margin: 0; max-width: 56ch; }

    @media (max-width: 620px) {
      .project { grid-template-columns: 1fr; gap: 12px; }
      .shot img, .ph { aspect-ratio: 16 / 9; }
    }
  </style>
</Base>
