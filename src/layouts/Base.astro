---
import '../styles/global.css';
import LiveCount from '../components/LiveCount.astro';

// build date, shown in the footer; refreshes on every deploy
const updated = new Date()
  .toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
  .toLowerCase();

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'poshitha upparapalli. computer science and finance at lehigh. building ai for small-business owners, and interested in brain-computer interfaces, reinforcement learning, and computer vision.',
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://poshithaupparapalli.com');
const links = [
  ['/', 'home'],
  ['/work', 'work'],
  ['/projects', 'projects'],
  ['/photos', 'photos'],
  // ['/favorites', 'favorites'], // paused for now
  // ['/sketchbook', 'sketchbook'], // hidden until the sketches are uploaded
  // ['/writings', 'writings'], // hidden for now — pages still exist, just unlinked
  ['/about', 'about'],
];
const current = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// tells google this site is a person, and which accounts are the same person.
// this is what makes a name search line up with the site
const isHome = path === '/';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Poshitha Upparapalli',
  alternateName: 'Poshitha Reddy Upparapalli',
  url: 'https://poshithaupparapalli.com',
  jobTitle: 'Software Engineer',
  description:
    'Computer science and finance student at Lehigh University. Building AI for small-business owners, and interested in brain-computer interfaces, reinforcement learning, and computer vision.',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Lehigh University',
    sameAs: 'https://www.lehigh.edu',
  },
  knowsAbout: [
    'computer vision',
    'reinforcement learning',
    'brain-computer interfaces',
    'machine learning',
    'formal verification',
    'venture capital',
  ],
  sameAs: [
    'https://github.com/poshithaupparapalli',
    'https://www.linkedin.com/in/poshithar/',
    'https://poshitha.substack.com',
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="poshitha upparapalli" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="poshitha upparapalli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(person)} />
    )}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%231f2328'/><text x='50' y='63' font-size='52' font-weight='700' fill='%23f5f0e4' text-anchor='middle' font-family='sans-serif'>pu</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="wrap">
      <header class="site-head">
        <nav class="site-nav">
          {links.map(([href, label]) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <div class="head-right">
          <LiveCount />
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-foot">made by poshitha · updated {updated}</footer>
    </div>
  </body>
</html>
