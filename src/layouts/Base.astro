---
import '../styles/global.css';
const { title = 'poshitha' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  ['/projects/', 'projects'],
  ['/photos/', 'photos'],
  ['/movies/', 'movies & books'],
  ['/writings/', 'writings'],
  ['/about/', 'about'],
];
const here = (href) => path === href || path === href.slice(0, -1);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  <script is:inline>
    // set theme before paint so there's no flash
    var t = 'light';
    try { var s = localStorage.getItem('theme'); if (s) t = s; } catch (e) {}
    document.documentElement.setAttribute('data-theme', t);
  </script>
</head>
<body>
  <header>
    <a class="wordmark" href="/">poshitha</a>
    <div class="right">
      <nav>
        {links.map(([href, label]) => (
          <a href={href} aria-current={here(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <button class="toggle" id="toggle" aria-label="lights off">
        <svg id="toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></svg>
      </button>
    </div>
  </header>

  <slot />

  <script>
    const btn = document.getElementById('toggle');
    const icon = document.getElementById('toggle-icon');
    const MOON = '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>';
    const SUN = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>';

    function apply() {
      const t = document.documentElement.getAttribute('data-theme');
      icon.innerHTML = t === 'dark' ? SUN : MOON;
      btn.setAttribute('aria-label', t === 'dark' ? 'lights on' : 'lights off');
    }
    btn.addEventListener('click', () => {
      const t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', t);
      try { localStorage.setItem('theme', t); } catch (e) {}
      apply();
    });
    apply();
  </script>
</body>
</html>
