---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  ['/', 'home'],
  ['/work', 'work'],
  ['/projects', 'projects'],
  ['/writings', 'writings'],
  ['/about', 'about'],
];
const current = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='38' fill='%231f2328'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // light is the default — only flip if dark was chosen before
      if (localStorage.getItem('theme') === 'dark')
        document.documentElement.setAttribute('data-theme', 'dark');
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="site-head">
        <nav class="site-nav">
          {links.map(([href, label]) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <button class="toggle" id="theme-toggle" aria-label="toggle dark mode">☾</button>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-foot">poshitha upparapalli</footer>
    </div>
    <script>
      const btn = document.getElementById('theme-toggle')!;
      const root = document.documentElement;
      const paint = () => { btn.textContent = root.getAttribute('data-theme') === 'dark' ? '☀' : '☾'; };
      btn.addEventListener('click', () => {
        const dark = root.getAttribute('data-theme') === 'dark';
        if (dark) root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', dark ? 'light' : 'dark');
        paint();
      });
      paint();
    </script>
  </body>
</html>
