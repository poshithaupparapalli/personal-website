---
import '../styles/global.css';
import Particles from '../components/Particles.astro';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'poshitha upparapalli — computer science and finance at lehigh. building ai for small-business owners, and interested in brain-computer interfaces, reinforcement learning, and computer vision.',
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://poshithaupparapalli.com');
const links = [
  ['/', 'home'],
  ['/work', 'work'],
  ['/projects', 'projects'],
  ['/writings', 'writings'],
  ['/about', 'about'],
];
const current = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="poshitha upparapalli" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="poshitha upparapalli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='38' fill='%231f2328'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // dark is the default — only flip if light was chosen before
      if (localStorage.getItem('theme') === 'light')
        document.documentElement.setAttribute('data-theme', 'light');
    </script>
  </head>
  <body>
    <Particles />
    <div class="wrap">
      <header class="site-head">
        <nav class="site-nav">
          {links.map(([href, label]) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <button class="toggle" id="theme-toggle" aria-label="toggle dark mode">☾</button>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-foot">made by poshitha</footer>
    </div>
    <script>
      const btn = document.getElementById('theme-toggle')!;
      const root = document.documentElement;
      // no attribute means dark, since dark is the default
      const isLight = () => root.getAttribute('data-theme') === 'light';
      const paint = () => { btn.textContent = isLight() ? '☾' : '☀'; };
      btn.addEventListener('click', () => {
        if (isLight()) root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', isLight() ? 'light' : 'dark');
        paint();
      });
      paint();
    </script>
  </body>
</html>
